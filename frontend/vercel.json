{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/assistant", "destination": "/assistant.html" },
    { "source": "/assistant/", "destination": "/assistant.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/customer", "destination": "/customer/index.html" },
    { "source": "/customer/", "destination": "/customer/index.html" },
    { "source": "/auditor", "destination": "/auditor/index.html" },
    { "source": "/auditor/", "destination": "/auditor/index.html" }
  ]
}
